@using Microsoft.AspNetCore.Components

<div class="card mb-3">
    <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">

        <!-- Left: Input -->
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 fw-semibold">
                Reviewers per paper:
            </label>

            <input type="number"
                   min="1"
                   class="form-control form-control-sm"
                   style="width: 80px;"
                   value="@ReviewersPerPaper"
                   @oninput="OnInputChanged" />
        </div>

        <!-- Right: Actions -->
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm"
                    @onclick="OnPreviewAutoAssign">
                <i class="bi bi-lightning"></i>
                Auto Assign
            </button>
        </div>

    </div>
</div>

@code {
    /// <summary>
    /// Number of reviewers to assign per paper.
    /// </summary>
    [Parameter] public int ReviewersPerPaper { get; set; }

    [Parameter] public EventCallback<int> ReviewersPerPaperChanged { get; set; }

    /// <summary>
    /// Invoked when the user requests auto-assignment preview.
    /// </summary>
    [Parameter] public EventCallback OnPreviewAutoAssign { get; set; }
    
    private async Task OnInputChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            await ReviewersPerPaperChanged.InvokeAsync(value);
        }
    }
}