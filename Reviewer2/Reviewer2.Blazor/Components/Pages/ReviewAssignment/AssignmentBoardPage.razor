@page "/assignments"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Reviewer2.Services.DTOs.ReviewAssignments
@using Reviewer2.Services.ReviewAssignments
@using Serilog
@inject IReviewAssignmentService ReviewAssignmentService
@inject NavigationManager Navigation

@attribute [Authorize(Roles = "Admin, PaperChair")]

<PageTitle>Reviewer Assignment</PageTitle>

<h3>Reviewer Assignment Board</h3>

@if (_isLoading)
{
    <p>Loading...</p>
}
else if (_board is null)
{
    <p>Failed to load assignment board.</p>
}
else
{
    <!-- Toolbar -->
    <AssignmentToolbar 
        @bind-ReviewersPerPaper="_reviewersPerPaper"
        OnPreviewAutoAssign="HandlePreviewAutoAssign" />

    <ErrorAlert Message="@_errorMessage" />
    
    <!-- Main Board -->
    <AssignmentBoard 
        Papers="_board.Papers"
        Reviewers="_board.Reviewers"
        OnAssign="HandleAssign"
        OnRemove="HandleRemove" />

    <!-- Preview Modal -->
    <AutoAssignPreviewModal 
        Visible="_showPreview"
        Preview="_preview"
        OnConfirm="HandleConfirmAutoAssign"
        OnCancel="HandleCancelPreview" />
}

@code {
    private ReviewAssignmentBoardDTO? _board;
    private bool _isLoading = true;

    // Auto-assign preview state
    private List<AutoAssignmentPreviewDTO> _preview = new();
    private bool _showPreview = false;

    private int _reviewersPerPaper = 3;
    
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadBoardAsync();
    }

    private async Task LoadBoardAsync()
    {
        _isLoading = true;
        _board = await ReviewAssignmentService.GetAssignmentBoardAsync();
        _isLoading = false;
    }

    private async Task HandleAssign(Guid paperId, Guid reviewerId)
    {
        var result = await ReviewAssignmentService.AssignReviewerAsync(paperId, reviewerId);

        if (result != AssignmentResult.Success)
        {
            await ShowError(result switch
            {
                AssignmentResult.AlreadyAssigned =>
                    "This reviewer is already assigned to the paper.",

                AssignmentResult.ReviewerIsAuthor =>
                    "This reviewer cannot be assigned because they are an author of the paper.",

                AssignmentResult.NotFound =>
                    "The selected paper or reviewer could not be found.",

                _ =>
                    "An unexpected error occurred while assigning the reviewer."
            });

            return;
        }

        _errorMessage = null;

        //Soft Reload, Buggy. In a perfect world, the drag and drop cloned sortable item bug should get fixed.
        //await LoadBoardAsync();
        //await InvokeAsync(StateHasChanged);

        //Force Reload, Equally jank, but works.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task HandleRemove(Guid assignmentId)
    {
        var result = await ReviewAssignmentService.RemoveReviewerAsync(assignmentId);

        if (result != AssignmentResult.Success)
        {
            await ShowError("Failed to remove reviewer assignment.");
            return;
        }

        _errorMessage = null;

        await LoadBoardAsync();
        
        await InvokeAsync(StateHasChanged);
    }
    
    private async Task HandlePreviewAutoAssign()
    {
        _preview = await ReviewAssignmentService
            .PreviewAutoAssignAsync(_reviewersPerPaper);

        _showPreview = true;
    }

    private async Task HandleConfirmAutoAssign()
    {
        var created = await ReviewAssignmentService
            .AutoAssignReviewersAsync(_reviewersPerPaper);

        Log.Information("Created {Created} assignments.", created);

        _showPreview = false;

        await LoadBoardAsync();
        
        await InvokeAsync(StateHasChanged);
    }

    private void HandleCancelPreview()
    {
        _showPreview = false;
    }
    
    private async Task ShowError(string message)
    {
        _errorMessage = message;
        StateHasChanged();

        await Task.Delay(3000); // 3 seconds

        _errorMessage = null;
        StateHasChanged();
    }
}