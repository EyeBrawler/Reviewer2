@page "/templates/create"
@rendermode InteractiveServer

@using Reviewer2.Services.DTOs.ReviewTemplates
@using Reviewer2.Services.CRUD.ReviewTemplates

@inject IReviewTemplateService TemplateService

<h3>Create Review Template</h3>

<EditForm Model="_model" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <!-- Template Name -->
    <div class="mb-3">
        <label class="form-label">Template Name</label>
        <InputText class="form-control" @bind-Value="_model.Name" />
    </div>

    <!-- Activate -->
    <div class="form-check mb-4">
        <InputCheckbox class="form-check-input" @bind-Value="_model.SetAsActive" />
        <label class="form-check-label">Set as Active</label>
    </div>

    <hr />

    <h5>Fields</h5>

    @if (!_model.Fields.Any())
    {
        <div class="alert alert-secondary">
            No fields added yet.
        </div>
    }

    @foreach (var field in _model.Fields)
    {
        <div class="card mb-3">
            <div class="card-body">

                <div class="row g-2">

                    <!-- Label -->
                    <div class="col-md-4">
                        <label class="form-label">Label</label>
                        <InputText class="form-control" @bind-Value="field.Label" />
                    </div>

                    <!-- Type -->
                    <div class="col-md-3">
                        <label class="form-label">Type</label>
                        <InputSelect class="form-select" @bind-Value="field.Type">
                            @foreach (var type in Enum.GetValues<ReviewFieldType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </InputSelect>
                    </div>

                    <!-- Required -->
                    <div class="col-md-2 d-flex align-items-end">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="field.Required" />
                            <label class="form-check-label">Required</label>
                        </div>
                    </div>

                    <!-- Remove Button -->
                    <div class="col-md-3 d-flex align-items-end justify-content-end">
                        <button type="button"
                                class="btn btn-outline-danger"
                                @onclick="() => RemoveField(field)">
                            <i class="bi bi-trash me-1"></i>
                            Remove
                        </button>
                    </div>
                </div>

                <!-- Number Options -->
                @if (field.Type == ReviewFieldType.Number)
                {
                    <div class="row mt-3">
                        <div class="col-md-3">
                            <label class="form-label">Min</label>
                            <InputNumber class="form-control" @bind-Value="field.Min" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Max</label>
                            <InputNumber class="form-control" @bind-Value="field.Max" />
                        </div>
                    </div>
                }

                <!-- Select Options -->
                @if (field.Type == ReviewFieldType.Select)
                {
                    <div class="mt-3">
                        <label class="form-label">Options</label>

                        @{
                            field.Options ??= [];
                        }

                        @for (var i = 0; i < field.Options.Count; i++)
                        {
                            var index = i;

                            <div class="input-group mb-2">
                                <InputText class="form-control" @bind-Value="field.Options[index]" />

                                <button type="button"
                                        class="btn btn-outline-danger"
                                        @onclick="() => RemoveOption(field, index)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        }

                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                @onclick="() => AddOption(field)">
                            <i class="bi bi-plus-circle me-1"></i>
                            Add Option
                        </button>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Add Field -->
    <button type="button"
            class="btn btn-outline-primary mb-4"
            @onclick="AddField">
        <i class="bi bi-plus-lg me-1"></i>
        Add Field
    </button>

    <div>
        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle me-1"></i>
            Create Template
        </button>
    </div>

    @if (_error is not null)
    {
        <div class="alert alert-danger mt-3">
            @_error
        </div>
    }

</EditForm>

@code {
    private ReviewTemplateCreateRequest _model = new();

    private string? _error;

    private void AddField()
    {
        _model.Fields.Add(new TemplateFieldDTO());
    }

    private void RemoveField(TemplateFieldDTO field)
    {
        _model.Fields.Remove(field);
    }

    private void AddOption(TemplateFieldDTO field)
    {
        field.Options ??= new List<string>();
        field.Options.Add(string.Empty);
    }

    private void RemoveOption(TemplateFieldDTO field, int index)
    {
        field.Options?.RemoveAt(index);
    }

    private async Task HandleSubmit()
    {
        _error = null;

        try
        {
            await TemplateService.CreateAsync(_model);

            // Reset form after success
            _model = new ReviewTemplateCreateRequest();

        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}