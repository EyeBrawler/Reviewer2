@if (string.IsNullOrWhiteSpace(FileUrl))
{
    <div class="alert alert-warning mb-0">
        No preview available.
    </div>
}
else
{
    <section class="card shadow-sm p-4 mb-4">
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <h3>@Title</h3>
        }

        <div class="border rounded mt-3" style="height:@Height;">
            <iframe src="@FileUrl"
                    width="100%"
                    height="100%"
                    style="border:none;">
            </iframe>
        </div>
    </section>
}

@code {
    [Parameter] public string? FileUrl { get; set; }

    [Parameter] public string Title { get; set; } = "Document Preview";

    [Parameter] public string Height { get; set; } = "800px";
}