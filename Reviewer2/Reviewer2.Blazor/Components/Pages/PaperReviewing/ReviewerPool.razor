@using Reviewer2.Data.Models
@inject IJSRuntime JS
@implements IDisposable

<div class="reviewer-pool-sidebar" @ref="poolRef">
    <div class="pool-header">
        <h4>Reviewers</h4>
        <span class="count-badge">@Reviewers.Count</span>
    </div>

    <ul class="reviewer-list">
        @foreach (var reviewer in Reviewers)
        {
            <li class="reviewer-item"
                data-reviewer-id="@reviewer.UserId">
                <span class="handle">⠿</span>
                <span class="name">@reviewer.Name</span>
                @if (reviewer.CurrentAssignmentCount > 0)
                {
                    <span class="assignment-dot">@reviewer.CurrentAssignmentCount</span>
                }
            </li>
        }
    </ul>
</div>

@code {
    [Parameter] public List<ReviewerItem> Reviewers { get; set; } = new();

    private ElementReference poolRef;
    private DotNetObjectReference<ReviewerPool>? objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initReviewerPool", poolRef, objRef);
        }
    }

    [JSInvokable]
    public Task OnDragStartJS(string reviewerId)
    {
        // Optional: Highlight potential conflicts in the UI
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }
}