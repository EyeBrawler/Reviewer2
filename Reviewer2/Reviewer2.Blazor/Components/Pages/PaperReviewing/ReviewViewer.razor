@using Reviewer2.Services.DTOs.ReviewSubmission
@using Reviewer2.Services.DTOs.ReviewTemplates

<div class="card shadow-sm">
    <div class="card-body">

        <h6 class="card-subtitle mb-2">
            <span class="badge bg-secondary me-2">
                @(IsMyReview
                    ? "Your Review"
                    : $"Reviewer {Index}")
            </span>

            @if (Review.SubmittedAtUtc is not null)
            {
                <span class="ms-2">
                    (@Review.SubmittedAtUtc.Value.ToLocalTime().ToString("MMM dd, yyyy h:mm tt"))
                </span>
            }
        </h6>

        <!-- Scores -->
        <div class="mb-2">
            <strong>Overall Score:</strong>
            @DisplayOrDash(Review.OverallScore)
        </div>

        <div class="mb-2">
            <strong>Confidence:</strong>
            @DisplayOrDash(Review.ConfidenceScore)
        </div>

        <!-- Recommendation -->
        <div class="mb-3">

            <strong class="me-2">
                Recommendation:
            </strong>

            <span class="badge bg-primary">
                @(string.IsNullOrWhiteSpace(Review.Recommendation)
                    ? "—"
                    : Review.Recommendation)
            </span>

        </div>

        <!-- Dynamic Review Fields -->
        <div class="mt-4">

            <h6 class="fw-semibold mb-3">
                Review Details
            </h6>

            <div class="border rounded bg-light p-3">

                @if (Template.Fields.Count == 0)
                {
                    <div class="text-muted">
                        No template fields.
                    </div>
                }
                else
                {
                    @foreach (var field in Template.Fields)
                    {
                        var value = Review.Values.GetValueOrDefault(field.Key);

                        <div class="row mb-3">

                            <div class="col-sm-4 fw-semibold text-muted">
                                @field.Label
                            </div>

                            <div class="col-sm-8">
                                @DisplayFieldValue(field.Type, value)
                            </div>

                        </div>
                    }
                }

            </div>

        </div>

    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required ReviewDTO Review { get; set; }
    
    [Parameter, EditorRequired]
    public required ReviewTemplateDTO Template { get; set; }

    [Parameter]
    public int Index { get; set; }
    
    [Parameter]
    public Guid? CurrentUserReviewAssignmentId { get; set; }

    private static string DisplayOrDash(int? value)
        => value?.ToString() ?? "-";
    
    private bool IsMyReview =>
        CurrentUserReviewAssignmentId is { } assignmentId &&
        Review.ReviewAssignmentId == assignmentId;

    private static string DisplayFieldValue(
        ReviewFieldType type,
        ReviewValue? value)
    {
        if (value is null || value.IsEmpty())
            return "—";

        return type switch
        {
            ReviewFieldType.Text =>
                value.StringValue ?? "—",

            ReviewFieldType.Number =>
                value.NumberValue?.ToString() ?? "—",

            ReviewFieldType.Boolean =>
                value.BoolValue ? "Yes" : "No",

            ReviewFieldType.Select =>
                value.StringValue ?? "—",

            _ => "—"
        };
    }
}