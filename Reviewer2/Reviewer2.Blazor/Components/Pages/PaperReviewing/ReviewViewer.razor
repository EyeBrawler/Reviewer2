@using Reviewer2.Services.DTOs.ReviewSubmission

<div class="card shadow-sm">
    <div class="card-body">

        <h6 class="card-subtitle mb-2">
            <span class="badge bg-secondary me-2">Reviewer @Index</span>
            @if (Review.SubmittedAtUtc is not null)
            {
                <span class="ms-2">
                    (@Review.SubmittedAtUtc.Value.ToLocalTime():g)
                </span>
            }
        </h6>

        <!-- Scores -->
        <div class="mb-2">
            <strong>Overall Score:</strong>
            @DisplayOrDash(Review.OverallScore)
        </div>

        <div class="mb-2">
            <strong>Confidence:</strong>
            @DisplayOrDash(Review.ConfidenceScore)
        </div>

        <!-- Recommendation -->
        <div class="mb-2">
            <strong class="text-primary">Recommendation:</strong>
            @(string.IsNullOrWhiteSpace(Review.Recommendation)
                ? "-"
                : Review.Recommendation)
        </div>

        <!-- JSON Content -->
        <div class="mt-3">
            <strong>Review Details:</strong>
            <div class="border rounded p-2 mt-1 bg-light">
                <pre class="mb-0">@FormatJson(Review.JsonContent)</pre>
            </div>
        </div>

    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required ReviewDTO Review { get; set; }
    
    [Parameter]
    public int Index { get; set; }

    private static string DisplayOrDash(int? value)
        => value?.ToString() ?? "-";

    private static string FormatJson(string json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return "-";

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return System.Text.Json.JsonSerializer.Serialize(
                doc,
                new System.Text.Json.JsonSerializerOptions
                {
                    WriteIndented = true
                });
        }
        catch
        {
            return json; // fallback if invalid JSON
        }
    }
}