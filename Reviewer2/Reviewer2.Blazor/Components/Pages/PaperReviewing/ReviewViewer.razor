@using Reviewer2.Services.DTOs.ReviewSubmission

<div class="card shadow-sm">
    <div class="card-body">

        <h6 class="card-subtitle mb-2">
            <span class="badge bg-secondary me-2">
                Reviewer @Index
            </span>

            @if (Review.SubmittedAtUtc is not null)
            {
                <span class="ms-2">
                    (@Review.SubmittedAtUtc.Value
                        .ToLocalTime()
                        .ToString("MMM dd, yyyy h:mm tt"))
                </span>
            }
        </h6>

        <!-- Scores -->
        <div class="mb-2">
            <strong>Overall Score:</strong>
            @DisplayOrDash(Review.OverallScore)
        </div>

        <div class="mb-2">
            <strong>Confidence:</strong>
            @DisplayOrDash(Review.ConfidenceScore)
        </div>

        <!-- Recommendation -->
        <div class="mb-2">
            <strong class="text-primary">
                Recommendation:
            </strong>

            @(string.IsNullOrWhiteSpace(Review.Recommendation)
                ? "-"
                : Review.Recommendation)
        </div>

        <!-- Dynamic Review Fields -->
        <div class="mt-3">
            <strong>Review Details:</strong>

            <div class="border rounded p-2 mt-1 bg-light">

                @if (Review.Values.Count == 0)
                {
                    <div class="text-muted">
                        No review details available.
                    </div>
                }
                else
                {
                    @foreach (var field in Review.Values)
                    {
                        <div class="mb-2">
                            <strong>@FormatFieldName(field.Key):</strong>
                            @DisplayValue(field.Value)
                        </div>
                    }
                }

            </div>
        </div>

    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required ReviewDTO Review { get; set; }

    [Parameter]
    public int Index { get; set; }

    private static string DisplayOrDash(int? value)
        => value?.ToString() ?? "-";

    private static string DisplayValue(ReviewValue value)
    {
        if (value.IsEmpty())
            return "-";

        return value.ToString();
    }

    private static string FormatFieldName(string key)
    {
        return string.IsNullOrWhiteSpace(key) ? "-" : key.Replace("_", " ");
    }
}