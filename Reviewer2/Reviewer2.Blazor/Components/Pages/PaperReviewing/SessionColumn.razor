@using Reviewer2.Data.Models
@inject IJSRuntime JS

<div class="session-column" @ref="columnRef">
    <div class="column-header">
        <h4 class="column-title">@SessionName</h4>
        <span class="paper-count">@Papers.Count papers</span>
    </div>

    <div class="column-body">
        @foreach (var paper in Papers)
        {
            <div class="paper-drop-zone" data-paper-id="@paper.Id">
                <PaperCard Paper="paper" OnReviewerDropped="OnReviewerDropped" />
            </div>
        }
        
        <div class="drop-zone-empty">
            <strong>Drop paper here</strong>
        </div>
    </div>
</div>

@code {
    [Parameter] public string SessionName { get; set; } = "";
    [Parameter] public List<Paper> Papers { get; set; } = new();
    [Parameter] public EventCallback<(Guid paperId, string sessionName)> OnPaperMoved { get; set; }
    [Parameter] public EventCallback<(Guid paperId, Guid reviewerId)> OnReviewerDropped { get; set; }

    private ElementReference columnRef;
    private DotNetObjectReference<SessionColumn>? objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initSessionColumn", columnRef, objRef, SessionName);
        }
    }

    [JSInvokable]
    public async Task OnPaperDroppedJS(string paperId, string targetSession)
    {
        if (Guid.TryParse(paperId, out var pId))
        {
            await OnPaperMoved.InvokeAsync((pId, targetSession));
        }
    }
}