@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using Reviewer2.Services.DTOs.ReviewSubmission
@using Reviewer2.Services.DTOs.ReviewTemplates
@using Reviewer2.Services.Reviews
@inject IReviewService ReviewService
@inject AuthenticationStateProvider AuthStateProvider

<EditForm EditContext="_editContext" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <fieldset disabled="@_isSubmitting">
    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="card-title">Review</h5>

            @if (_errorMessage is not null)
            {
                <div class="alert alert-danger">@_errorMessage</div>
            }

            <!-- Overall Score -->
            <div class="mb-3">
                <label class="form-label">Overall Score</label>
                <InputNumber class="form-control"
                             @bind-Value="_model.OverallScore"
                             type="number"
                             min="@(OverallScoreRange?.Minimum)"
                             max="@(OverallScoreRange?.Maximum)"
                             step="1" />
                <div class="form-text text-muted">
                    @GetFieldHint(nameof(_model.OverallScore))
                </div>
                <ValidationMessage For="@(() => _model.OverallScore)" />
            </div>

            <div class="mb-3">
                <label class="form-label">Confidence</label>
                <InputNumber class="form-control"
                             @bind-Value="_model.ConfidenceScore"
                             type="number"
                             min="@(ConfidenceScoreRange?.Minimum)"
                             max="@(ConfidenceScoreRange?.Maximum)"
                             step="1" />
                <div class="form-text text-muted">
                    @GetFieldHint(nameof(_model.ConfidenceScore))
                </div>
                <ValidationMessage For="@(() => _model.ConfidenceScore)" />
            </div>

            <!-- Recommendation -->
            <div class="mb-3">
                <label class="form-label">Recommendation</label>
                <InputSelect class="form-select"
                             @bind-Value="_model.Recommendation">
                    <option value="">Select...</option>
                    <option>Accept</option>
                    <option>Weak Accept</option>
                    <option>Borderline</option>
                    <option>Weak Reject</option>
                    <option>Reject</option>
                </InputSelect>
                <div class="form-text text-muted">
                    @GetFieldHint(nameof(_model.Recommendation))
                </div>
                <ValidationMessage For="@(() => _model.Recommendation)" />
            </div>

            <!-- Dynamic Review Fields -->
            @foreach (var field in Template.Fields)
            {
                <div class="mb-3">

                    <label class="form-label">
                        @field.Label

                        @if (field.Required)
                        {
                            <span class="text-danger">*</span>
                        }
                    </label>

                    @switch (field.Type)
                    {
                        case ReviewFieldType.Text:
                        {
                            <InputTextArea
                                class="form-control"
                                rows="4"
                                @bind-Value="ValueFor(field.Key).StringValue" />
                            break;
                        }

                        case ReviewFieldType.Number:
                        {
                            <InputNumber TValue="decimal?"
                                         class="form-control"
                                         @bind-Value="ValueFor(field.Key).NumberValue"
                                         min="@field.Min"
                                         max="@field.Max"
                                         step="1" />
                            break;
                        }

                        case ReviewFieldType.Boolean:
                        {
                            <div class="form-check">

                                <InputCheckbox
                                    class="form-check-input"
                                    Value="@GetBool(field.Key)"
                                    ValueChanged="@(value => SetBool(field.Key, value))"
                                    ValueExpression="@(() => GetBool(field.Key))" />

                            </div>

                            break;
                        }

                        case ReviewFieldType.Select:
                        {
                            <InputSelect TValue="string"
                                         class="form-select"
                                         @bind-Value="ValueFor(field.Key).StringValue">

                                <option value="">
                                    Select...
                                </option>

                                @foreach (var option in field.Options ?? [])
                                {
                                    <option value="@option">
                                        @option
                                    </option>
                                }

                            </InputSelect>

                            break;
                        }

                        default:
                        {
                            <div class="text-danger">
                                Unsupported field type: @field.Type
                            </div>
                            break;
                        }
                    }

                    @if (field is { Type: ReviewFieldType.Number, Min: not null, Max: not null })
                    {
                        <div class="form-text text-muted">
                            Enter a value between @field.Min and @field.Max.
                        </div>
                    }

                </div>
            }

            <!-- Actions -->
            <div class="d-flex gap-2">

                <!-- Save Draft (no validation) -->
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="SaveDraftAsync"
                        disabled="@(_isSaving || _isSubmitting)">
                    @(_isSaving ? "Saving..." : "Save Draft")
                </button>

                <!-- Submit (validated) -->
                <button type="submit"
                        class="btn btn-primary"
                        disabled="@_isSubmitting">
                    @(_isSubmitting ? "Submitting..." : "Submit Review")
                </button>

            </div>

        </div>
    </div>
    </fieldset>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public Guid ReviewAssignmentId { get; set; }

    [Parameter]
    public ReviewDTO? ExistingReview { get; set; }

    [Parameter, EditorRequired]
    public required ReviewTemplateDTO Template { get; set; }

    [Parameter]
    public EventCallback OnSubmitted { get; set; }
    
    private EditContext? _editContext;

    private SubmitReviewDTO _model = new();

    private Guid _currentUserId;

    private bool _isSaving;
    private bool _isSubmitting;
    private string? _errorMessage;
    
    // Property info for OverallScore
    private static readonly PropertyInfo OverallScoreProp =
        typeof(SubmitReviewDTO)
            .GetProperty(nameof(SubmitReviewDTO.OverallScore))!;

    private static readonly RangeAttribute? OverallScoreRange =
        OverallScoreProp.GetCustomAttribute<RangeAttribute>();

    private static readonly PropertyInfo ConfidenceScoreProp =
        typeof(SubmitReviewDTO)
            .GetProperty(nameof(SubmitReviewDTO.ConfidenceScore))!;

    private static readonly RangeAttribute? ConfidenceScoreRange =
        ConfidenceScoreProp.GetCustomAttribute<RangeAttribute>();
    
    private bool GetBool(string key)
        => ValueFor(key).BoolValue ?? false;

    private void SetBool(string key, bool value)
    {
        ValueFor(key).BoolValue = value;
    }

    protected override async Task OnInitializedAsync()
    {
        _currentUserId = await GetUserIdAsync();
    }

    protected override void OnInitialized()
    {
        _model = ExistingReview is not null
            ? CreateModelFromExisting()
            : new SubmitReviewDTO
            {
                ReviewAssignmentId = ReviewAssignmentId
            };

        InitializeDynamicFields();

        _editContext = new EditContext(_model);
    }

    private SubmitReviewDTO CreateModelFromExisting()
    {
        if (ExistingReview is null)
        {
            throw new InvalidOperationException(
            $"{nameof(CreateModelFromExisting)} called with no existing review.");
        }

        return new SubmitReviewDTO
        {
            ReviewAssignmentId = ExistingReview.ReviewAssignmentId,
            OverallScore = ExistingReview.OverallScore,
            ConfidenceScore = ExistingReview.ConfidenceScore,
            Recommendation = ExistingReview.Recommendation,

            Values = ExistingReview.Values.ToDictionary(
                entry => entry.Key,
                entry => new ReviewValue
                {
                    StringValue = entry.Value.StringValue,
                    NumberValue = entry.Value.NumberValue,
                    BoolValue = entry.Value.BoolValue
                })
        };
    }
    
    private void InitializeDynamicFields()
    {
        foreach (var field in Template.Fields)
        {
            _model.Values.TryAdd(
                field.Key,
                new ReviewValue
                {
                    BoolValue = field.Type == ReviewFieldType.Boolean
                        ? false
                        : null
                });
        }
    }
    
    private ReviewValue ValueFor(string key)
        => _model.Values[key];

    private async Task SaveDraftAsync()
    {
        if (_isSaving) return;
        
        _isSaving = true;
        _errorMessage = null;

        try
        {
            await ReviewService.SaveDraftAsync(_model, _currentUserId);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (_isSubmitting) return;

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            await ReviewService.SubmitReviewAsync(_model, _currentUserId);

            if (OnSubmitted.HasDelegate)
            {
                await OnSubmitted.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task<Guid> GetUserIdAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            throw new UnauthorizedAccessException("User is not authenticated.");
        }

        var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        return string.IsNullOrWhiteSpace(userIdClaim) ? throw new UnauthorizedAccessException("User identifier claim is missing.") : Guid.Parse(userIdClaim);
    }
    
    private static string GetFieldHint(string propertyName)
    {
        var member = typeof(SubmitReviewDTO).GetProperty(propertyName);
        if (member == null) return string.Empty;

        var hints = new List<string>();

        if (member.GetCustomAttribute<RangeAttribute>() is { } range)
            hints.Add($"Enter a number between {range.Minimum} and {range.Maximum}.");

        if (member.GetCustomAttribute<StringLengthAttribute>() is { } strLength)
            hints.Add($"Max {strLength.MaximumLength} characters.");

        if (member.GetCustomAttribute<RequiredAttribute>() is not null)
            hints.Add("This field is required.");

        return string.Join(" ", hints);
    }
}