@page "/reviewer-scheduling"

@using Reviewer2.Data.Models
@using Reviewer2.Data.Context
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<ApplicationContext> DbFactory

<div class="container-fluid py-3">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Reviewer Scheduling</h4>

        <div class="d-flex gap-2">

            <button class="btn btn-primary" @onclick="LoadData">
                Refresh
            </button>

            <input class="form-control"
                   style="width:200px"
                   placeholder="New bin..."
                   @bind="NewBinName" />

            <button class="btn btn-success" @onclick="AddBin">
                Add
            </button>

            <button class="btn btn-warning" @onclick="Save">
                Save
            </button>

        </div>
    </div>

    <!-- BOARD -->
    <div class="row g-3">

        @foreach (var bin in Bins)
        {
            <div class="col-12 col-md-4">

                <div class="card shadow-sm p-3 h-100"
                     @ondragover:preventDefault="true"
                     @ondrop="() => Drop(bin.Id)">

                    <!-- BIN HEADER -->
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>@bin.Label</strong>

                        @if (!bin.IsLocked)
                        {
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => RemoveBin(bin.Id)">
                                ✕
                            </button>
                        }
                    </div>

                    <div class="text-muted small mb-2">
                        @bin.Papers.Count papers
                    </div>

                    <!-- PAPERS -->
                    @foreach (var paper in bin.Papers)
                    {
                        <div class="border rounded p-2 mb-2 bg-light"
                             draggable="true"
                             @ondragstart="() => StartDrag(paper.Id)">

                            <div class="fw-bold">@paper.Title</div>
                            <div class="small text-muted">@paper.Status</div>
                            <div class="small">@paper.Abstract</div>

                        </div>
                    }

                </div>
            </div>
        }

    </div>
</div>

@code {
    private List<Bin> Bins = new();
    private Guid? DraggedPaperId;
    private string NewBinName = "";
    
    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }
    
    private async Task LoadData()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var papers = await db.Papers
            .AsNoTracking()
            .ToListAsync();

        Bins = new List<Bin>
        {
            new Bin("accepted", "Unscheduled Papers", true)
        };

        Bins[0].Papers.AddRange(papers);

        await InvokeAsync(StateHasChanged);
    }
    
    private Task AddBin()
    {
        if (string.IsNullOrWhiteSpace(NewBinName))
            return Task.CompletedTask;

        Bins.Add(new Bin(Guid.NewGuid().ToString(), NewBinName, false));

        NewBinName = "";

        return InvokeAsync(StateHasChanged);
    }
    
    private void RemoveBin(string id)
    {
        var bin = Bins.FirstOrDefault(b => b.Id == id);
        if (bin == null) return;

        var main = Bins.First(b => b.Id == "accepted");

        main.Papers.AddRange(bin.Papers);

        Bins.Remove(bin);

        StateHasChanged();
    }
    
    private void StartDrag(Guid paperId)
    {
        DraggedPaperId = paperId;
    }
    
    private void Drop(string binId)
    {
        if (DraggedPaperId == null)
            return;

        var paper = Bins
            .SelectMany(b => b.Papers)
            .FirstOrDefault(p => p.Id == DraggedPaperId);

        if (paper == null)
            return;

        foreach (var b in Bins)
        {
            b.Papers.RemoveAll(p => p.Id == DraggedPaperId);
        }

        var target = Bins.FirstOrDefault(b => b.Id == binId);
        target?.Papers.Add(paper);

        DraggedPaperId = null;

        StateHasChanged();
    }
    
    private void Save()
    {
        foreach (var bin in Bins)
        {
            Console.WriteLine($"{bin.Label}: {bin.Papers.Count} papers");
        }
    }
    
    public class Bin
    {
        public string Id { get; set; }
        public string Label { get; set; }
        public List<Paper> Papers { get; set; } = new();
        public bool IsLocked { get; set; }

        public Bin(string id, string label, bool locked)
        {
            Id = id;
            Label = label;
            IsLocked = locked;
        }
    }
}