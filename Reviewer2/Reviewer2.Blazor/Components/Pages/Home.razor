@page "/"
@rendermode InteractiveServer
@inject Reviewer2.Services.CRUD.Conferences.IConferenceService ConferenceService
@using Reviewer2.Services.DTOs.ConferenceManagement
@using MudBlazor

<PageTitle>Reviewer2</PageTitle>

<div class="container my-4">
    <h1 class="mb-4">Reviewer2 Conference Management System</h1>

    @if (IsLoading)
    {
        <div class="alert alert-info">Loading conference data...</div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }
    else
    {
        <div class="accordion" id="conferenceAccordion">
            <!-- Conference Info -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingInfo">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInfo" aria-expanded="true">
                        Conference Info
                    </button>
                </h2>
                <div id="collapseInfo" class="accordion-collapse collapse show" aria-labelledby="headingInfo" data-bs-parent="#conferenceAccordion">
                    <div class="accordion-body">
                        <EditForm Model="EditModel.Info" OnValidSubmit="SaveConferenceAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="mb-2">
                                <label>Name</label>
                                <InputText class="form-control" @bind-Value="EditModel.Info.Name" />
                            </div>
                            <div class="mb-2">
                                <label>Description</label>
                                <InputTextArea class="form-control" @bind-Value="EditModel.Info.Description" />
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Save Info</button>
                        </EditForm>
                    </div>
                </div>
            </div>

            <!-- Call For Papers -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingCFP">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCFP">
                        Call for Papers
                    </button>
                </h2>
                <div id="collapseCFP" class="accordion-collapse collapse" aria-labelledby="headingCFP" data-bs-parent="#conferenceAccordion">
                    <div class="accordion-body">
                        <EditForm Model="EditModel.CallForPapers" OnValidSubmit="SaveConferenceAsync">
                            <div class="mb-2">
                                <label>CFP Content</label>
                                <InputTextArea class="form-control" @bind-Value="EditModel.CallForPapers.Content" />
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">Save CFP</button>
                        </EditForm>
                    </div>
                </div>
            </div>

            <!-- Deadlines -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="headingDeadlines">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDeadlines">
                        Deadlines (@EditModel.Deadlines.Count)
                    </button>
                </h2>
                <div id="collapseDeadlines" class="accordion-collapse collapse" aria-labelledby="headingDeadlines" data-bs-parent="#conferenceAccordion">
                    <div class="accordion-body">
                        @foreach (var deadline in EditModel.Deadlines)
                        {
                            <div class="card mb-2">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <strong>@deadline.Name</strong>
                                    <button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveDeadline(deadline.Id)">Remove</button>
                                </div>
                                <div class="card-body">
                                    <div class="mb-2">
                                        <label>Name</label>
                                        <InputText class="form-control" @bind-Value="deadline.Name" />
                                    </div>
                                    <div class="mb-2">
                                        <label>Date</label>
                                        <MudDatePicker @bind-Date="deadline.Date"
                                                       Label="Deadline Date"
                                                       Variant="Variant.Filled"
                                                       Class="w-100" />
                                    </div>
                                    <div class="mb-2">
                                        <label>Priority</label>
                                        <InputNumber class="form-control" @bind-Value="deadline.Priority" />
                                    </div>
                                </div>
                            </div>
                        }

                        <button type="button" class="btn btn-secondary btn-sm" @onclick="AddDeadline">Add Deadline</button>
                        <button class="btn btn-primary btn-sm mt-2" @onclick="SaveConferenceAsync">Save All Deadlines</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Volunteer Reviewer Button -->
        <div class="mt-4">
            <VolunteerReviewerButton ShowTitle="true" ShowDescription="true" />
        </div>
    }
</div>

@code {
    private ConferenceEditDTO EditModel = new ConferenceEditDTO();
    private ConferenceEditDTO? Conference;
    private bool IsLoading = true;
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var entity = await ConferenceService.GetConferenceEntityAsync();
            if (entity != null)
            {
                Conference = entity.ToEditDTO();
                EditModel = entity.ToEditDTO();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Failed to load conference data: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SaveConferenceAsync()
    {
        ErrorMessage = null;
        try
        {
            var success = await ConferenceService.UpdateConferenceAsync(EditModel);
            if (!success)
                ErrorMessage = "Failed to save conference changes.";
            else
            {
                var entity = await ConferenceService.GetConferenceEntityAsync();
                if (entity != null)
                {
                    Conference = entity.ToEditDTO();
                    EditModel = entity.ToEditDTO();
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error saving conference: {ex.Message}";
        }
    }

    private void AddDeadline()
    {
        EditModel.Deadlines.Add(new ConferenceEditDTO.DeadlineInfo());
    }

    private void RemoveDeadline(int? id)
    {
        var d = EditModel.Deadlines.Find(x => x.Id == id);
        if (d != null) EditModel.Deadlines.Remove(d);
    }
}