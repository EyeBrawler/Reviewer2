@page "/"
@rendermode InteractiveServer
@using Reviewer2.Services.CRUD.Conferences
@using Reviewer2.Services.DTOs.ConferenceManagement
@inject IConferenceService ConferenceService

<PageTitle>Reviewer2</PageTitle>

<div class="container my-4">
    @if (_isLoading)
    {
        <div class="alert alert-info">Loading conference data...</div>
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger">@_errorMessage</div>
    }
    else if (_conference == null)
    {
        <div class="alert alert-warning">
            No conference has been configured yet.
        </div>

        <AuthorizeView Roles="Admin, ConferenceChair">
            <Authorized>
                <NavLink class="btn btn-primary" href="/conference-edit">
                    Create Conference
                </NavLink>
            </Authorized>
        </AuthorizeView>
    }
    else
    {
        <!-- Conference Info -->
        <div class="mb-4 d-flex justify-content-between align-items-start">
    
            <div>
                <h1 class="mb-1">@_conference.Name</h1>
                <p class="mb-0">@_conference.Description</p>
            </div>

            <AuthorizeView Roles="Admin, ConferenceChair">
                <Authorized>
                    <NavLink class="btn btn-warning btn-sm ms-3" href="/conference-edit">
                        <i class="bi bi-gear"></i> Edit
                    </NavLink>
                </Authorized>
            </AuthorizeView>

        </div>

        <!-- Call for Papers -->
        <div class="mb-4">
            <h4>Call for Papers</h4>
            <p>@_conference.CallForPapers</p>
        </div>

        <!-- Deadlines -->
        <div class="mb-4">
            <h4>Deadlines</h4>

            @if (_conference.Deadlines.Any())
            {
                <ul class="list-group">
                    @foreach (var d in _conference.Deadlines.OrderBy(d => d.Date))
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@d.Name</span>
                            <span>@d.Date.ToString("MMM dd, yyyy")</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p>No deadlines available.</p>
            }
        </div>
    }
    <!-- Volunteer Reviewer Button -->
    <div class="mt-4">
        <VolunteerReviewerButton ShowTitle="true" ShowDescription="true" />
    </div>
</div>

@code {
    private ConferenceDTO? _conference;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _conference = await ConferenceService.GetConferenceAsync();
        }
        catch
        {
            _errorMessage = "Failed to load conference data.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}